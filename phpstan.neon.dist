includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 8
    paths:
        - src
        - database
        - routes
    tmpDir: .phpstan.cache
    excludePaths:
        # php-parser 4 shim: only runs on php-parser 4 (see the class comment), cannot be analysed against the installed v5
        - src/DeepTrace/LegacyParser.php
    phpVersion: 80100
    checkOctaneCompatibility: true
    checkModelProperties: true
    treatPhpDocTypesAsCertain: false
    ignoreErrors:
        # the dashboard view lives in this package's own view namespace, which Larastan cannot see
        -
            message: '#expects view-string(\|null)?, string given#'
            path: src/Http/Controllers/DashboardController.php
